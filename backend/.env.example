PORT=8080
UPSTREAM_BASE=https://mai.chongxi.us
REPORT_UPSTREAM=https://maiapi.chongxi.us
POLL_INTERVAL_SEC=30
DATA_DIR=./data
HISTORY_MAX=20000
CORS_ALLOW=*

# 落雪查分器 OAuth(https://maimai.lxns.net/docs/oauth-guide)
# 1. 去 https://maimai.lxns.net/developer 创建 OAuth 应用
# 2. 回调地址登记为 http://localhost:3000/lxns-callback(本地开发可用 HTTP)
# 3. 权限至少勾选 openid + read_player(要用户名再加 profile)
LXNS_CLIENT_ID=
LXNS_CLIENT_SECRET=
LXNS_REDIRECT_URI=http://localhost:3000/lxns-callback
LXNS_SCOPES=openid profile read_player read_user_profile
